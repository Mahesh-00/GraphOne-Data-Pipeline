# LLM providers (fallback chain order set in src/config.py)
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# GitHub REST API
GITHUB_API_TOKEN=

# Storage
DATABASE_URL=sqlite+aiosqlite:///./graphone_raw.db

# Optional Google Sheets export settings
# GOOGLE_SERVICE_ACCOUNT_FILE=C:\path\to\service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_SHEET_ID=
# GOOGLE_WORKSHEET_NAME=GraphOne Data

# Concurrency / scale tuning
MAX_CONCURRENT_REQUESTS=25
MAX_CONCURRENT_LLM_CALLS=10
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=5
BASE_BACKOFF_SECONDS=1.0
MAX_BACKOFF_SECONDS=60.0
FRESHNESS_WINDOW_HOURS=24