# =====================================================================
# GraphOne Pipeline - .gitignore
# =====================================================================

# ---------------------------------------------------------------------
# 1. Environment & API Secrets (CRITICAL: NEVER COMMIT TO GIT)
# ---------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
credentials/
google-service-account.json
google-service-account*.json
service-account.json
service_account.json
credentials.json
token.json
client_secret*.json

# ---------------------------------------------------------------------
# 2. Local Databases & Data Dumps
# ---------------------------------------------------------------------
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
graphone_raw*.db
graphone_data_output.csv
*.csv

# ---------------------------------------------------------------------
# 3. Python Virtual Environments & Packages
# ---------------------------------------------------------------------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ---------------------------------------------------------------------
# 4. Python Cache & Build Artifacts
# ---------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ---------------------------------------------------------------------
# 5. Testing & Code Coverage
# ---------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# ---------------------------------------------------------------------
# 6. Scraper State, Scratch Scripts & Logs
# ---------------------------------------------------------------------
.scraper_state.json
scratch/
tmp/
temp/
*.log
*.log.*

# ---------------------------------------------------------------------
# 7. Frontend Dependencies & Build Output (Next.js / Node)
# ---------------------------------------------------------------------
node_modules/
web/node_modules/
.next/
web/.next/
out/
web/out/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------------------------------------------------------------------
# 8. IDE & Operating System Files
# ---------------------------------------------------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini